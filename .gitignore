# This is the public-release branch. Everything subject-level, pre-publication, or
# internal-process stays out by default -- see README.md's Data and reproducibility section.
# The only binary model files tracked here are the three retained checkpoints under
# checkpoints/, via Git LFS (see .gitattributes) -- not the outputs/ directory below.

# Clinical data, generated subject-level artifacts, and result artifacts
artifacts/
data/raw/
data/processed/
reports/private/

# Training outputs and logs (every run except the three retained checkpoints)
outputs/
checkpoints_*/
results/predictions/
logs/
logs_*.log
*.log
*.out
*.err

